{
  "name": "meeting-float-desktop",
  "productName": "Meeting Float Desktop",
  "version": "0.2.3",
  "description": "Electron desktop meeting assistant with live transcript, summaries, and minutes generation.",
  "author": "Axe Xu",
  "repository": {
    "type": "git",
    "url": "https://github.com/axeprpr/meeting-float-desktop.git"
  },
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "icons": "node scripts/generate-icons.mjs",
    "test:integration": "node scripts/integration-check.mjs",
    "test:protocol": "node --test scripts/meeting-protocol.test.mjs scripts/meeting-events.test.mjs",
    "test:ai": "node --test scripts/ai-client.test.mjs",
    "test:e2e": "node scripts/electron-e2e.mjs",
    "pack": "npm run build && electron-builder --dir --publish never",
    "dist:win": "npm run build && electron-builder --win nsis portable --publish never"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "0.3.0",
    "lucide-react": "0.577.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shadcn": "4.21.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.3.0",
    "electron-builder": "^26.0.12",
    "playwright": "^1.59.1",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.meetingfloat.desktop",
    "productName": "Meeting Float Desktop",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "icon": "assets/icon.png",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "axeprpr",
        "repo": "meeting-float-desktop",
        "releaseType": "release"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "meeting-float-desktop-${version}-${target}.${ext}"
    },
    "portable": {
      "artifactName": "meeting-float-desktop-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "meeting-float-desktop-${version}-setup.${ext}"
    }
  },
  "overrides": {
    "@babel/plugin-transform-runtime": "7.29.7"
  }
}
