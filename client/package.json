{
  "name": "meeting-assistant-desktop",
  "productName": "Meeting Assistant Desktop",
  "version": "1.0.1",
  "description": "Electron desktop meeting assistant with live transcript, summaries, and minutes generation.",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "prebuild": "npm run icons",
    "build": "tsc --noEmit && vite build",
    "prebuild:win7": "npm run icons",
    "build:win7": "tsc --noEmit && vite build --mode win7",
    "start": "electron .",
    "icons": "node scripts/generate-icons.mjs",
    "test:integration": "node scripts/integration-check.mjs",
    "test:protocol": "node --test scripts/meeting-protocol.test.mjs scripts/meeting-events.test.mjs scripts/stage-summary-bubbles.test.mjs scripts/wav-import.test.mjs",
    "test:e2e": "node scripts/electron-e2e.mjs",
    "test:e2e:win7": "node scripts/electron-e2e.mjs --win7",
    "pack:win7": "npm run build:win7 && electron-builder --config electron-builder.win7.cjs --dir --x64 --publish never",
    "dist:win7": "npm run build:win7 && electron-builder --config electron-builder.win7.cjs --win nsis portable --x64 --publish never",
    "dist:win:all": "npm run dist:win && npm run dist:win7",
    "pack": "npm run build && electron-builder --dir --publish never",
    "dist:win": "npm run build && electron-builder --win nsis portable --publish never"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "0.3.0",
    "lucide-react": "0.577.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shadcn": "4.21.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "culori": "4.0.2",
    "electron": "35.7.5",
    "electron-builder": "^26.0.12",
    "playwright": "^1.59.1",
    "png-to-ico": "^3.0.1",
    "postcss": "8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "1.0.7",
    "tailwindcss-v3": "npm:tailwindcss@3.4.17",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "wait-on": "^8.0.3"
  },
  "config": {
    "electron_mirror": "https://npmmirror.com/mirrors/electron/",
    "electron_builder_binaries_mirror": "https://npmmirror.com/mirrors/electron-builder-binaries/"
  },
  "build": {
    "appId": "com.quantitative.desktop",
    "productName": "Meeting Assistant Desktop",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "icon": "assets/icon.png",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "signAndEditExecutable": true,
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "meeting-assistant-desktop-${version}-${target}.${ext}"
    },
    "portable": {
      "artifactName": "meeting-assistant-desktop-${version}-portable.${ext}"
    },
    "nsis": {
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "meeting-assistant-${version}-setup.${ext}"
    }
  },
  "overrides": {
    "@babel/plugin-transform-runtime": "7.29.7"
  }
}
