# Optional local GPU service only; the app can connect to a remote model without this profile.
# VLLM_IMAGE=qwenllm/qwen3-asr:latest
# These variables configure the Compose vLLM service, not the application client.
# Local Qwen3-ASR model in ./models/qwen3-asr-1.7b, served by vLLM.
VLLM_MODEL=qwen3-asr-1.7b
VLLM_MODEL_PATH=/models/qwen3-asr-1.7b
# Keep startup below the available VRAM (12 GiB cards typically need 0.8).
VLLM_GPU_MEMORY_UTILIZATION=0.8
# 32k leaves enough KV cache on a 12 GiB card (the model advertises 65,536).
VLLM_MAX_MODEL_LEN=32768
# Configure ASR and LLM connections in the web UI: 模型配置.
# Connection settings are saved to SQLite and read from there for each new task.
# Local tokenizer directory: tokenizer_config.json + vocab.json + merges.txt,
# or a single tokenizer.json. Start uv from the project root.
# Compose mounts ./data at /app/data and runs the app from /app, so this relative path also works there.
ASR_TOKENIZER=data/tokenizers/qwen
# Optional absolute path for Docker: ASR_TOKENIZER=/app/data/tokenizers/qwen
# Local paths only; model IDs and automatic tokenizer downloads are not supported.
# Qwen prefix continuation only: false uses the model service's own template.
# Set true to send the app's built-in prompt; vLLM must allow request templates
# (--trust-request-chat-template). Use true with the optional Compose GPU service.
ASR_SEND_CHAT_TEMPLATE=false
# Live ASR uses a bounded rolling window. Requests run every stride seconds
# and never grow with the length of the current utterance.
ASR_WINDOW_SECONDS=5
ASR_STRIDE_SECONDS=2
# Optional server limits for long-meeting summaries.
# LLM_MAX_TOKENS=16384
# LLM_CHUNK_CHARS=12000
# Real-time stage summaries use non-overlapping archived-audio windows.
# STAGE_SUMMARY_WINDOW_SECONDS=300
# STAGE_SUMMARY_MAX_TOKENS=1200
# SQLite metadata/model settings, transcripts/ and minutes/ beside the database.
# DATA_DIR=data/archives
# DATABASE_PATH=data/archives/meetings.sqlite3

# Automatic anonymous speakers; no voice enrollment or reference recording.
# Install app and CPU model dependencies together: uv sync
# Local model files only. Missing files are reported without attempting downloads.
DIARIZATION_MODEL_DIR=models/diarization
# Local segmentation model directory containing pytorch_model.bin.
DIARIZATION_SEGMENTATION_DIR=models/pyannote/segmentation-3.0
DIARIZATION_WORKERS=1
DIARIZATION_THREADS=2
DIARIZATION_TIMEOUT_SECONDS=120
DIARIZATION_FINAL_TIMEOUT_SECONDS=1800
