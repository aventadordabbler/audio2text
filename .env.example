# These variables configure the Compose vLLM service, not the application client.
# Local Qwen3-ASR model in ./models/qwen3-asr-1.7b, served by vLLM.
VLLM_MODEL=qwen3-asr-1.7b
VLLM_MODEL_PATH=/models/qwen3-asr-1.7b
# Keep startup below the available VRAM (12 GiB cards typically need 0.8).
VLLM_GPU_MEMORY_UTILIZATION=0.8
# 32k leaves enough KV cache on a 12 GiB card (the model advertises 65,536).
VLLM_MAX_MODEL_LEN=32768
# Configure ASR and LLM connections in the web UI: 模型配置.
# Connection settings are saved to SQLite and read from there for each new task.
# Optional server limits for long-meeting summaries.
# LLM_MAX_TOKENS=16384
# LLM_CHUNK_CHARS=12000
# SQLite metadata/model settings, transcripts/ and minutes/ beside the database.
# DATA_DIR=data/archives
# DATABASE_PATH=data/archives/meetings.sqlite3
